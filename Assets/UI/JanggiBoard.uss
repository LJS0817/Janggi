/* ============================================================
   장기 덱빌딩 디펜스 - 3D 섀도우 엘리먼트 레이어링 테마
   (모든 UI에 piece-shadow와 동일한 전용 섀도우 엘리먼트 적용)
   ============================================================ */

/* ════════════════════════════════════════════════════════════ */
/* 0. 테마 색상 변수 (CSS Custom Properties) */
/* ════════════════════════════════════════════════════════════ */

:root {
    --theme-primary: rgb(29, 116, 178);
    --theme-primary-dark: rgb(21, 88, 140);
    --theme-primary-light: rgb(70, 148, 208);
    --theme-primary-bg: rgb(242, 247, 252);
    --theme-primary-tint: rgb(224, 238, 248);
    --theme-primary-border: rgb(165, 202, 230);
    --theme-primary-hover: rgba(29, 116, 178, 0.12);
    --theme-primary-move: rgba(29, 116, 178, 0.28);
    --theme-primary-move-hover: rgba(29, 116, 178, 0.55);
    --theme-screen-bg: rgb(246, 248, 251);
    --theme-board-bg: #EDF3F8;
    --theme-board-border: rgb(29, 116, 178);
    --theme-board-shadow: rgb(21, 88, 140);
    --theme-board-line: rgb(75, 122, 162);

    /* 🔴 적 AI (漢 / Han) 고유 테마 컬러 - 고급스러운 매트 루비 버건디 */
    --theme-han-primary: rgb(186, 52, 52);
    --theme-han-dark: rgb(146, 36, 36);
    --theme-han-light: rgb(212, 78, 78);
    --theme-han-bg: rgb(253, 246, 246);
    --theme-han-tint: rgb(248, 230, 230);
    --theme-han-border: rgb(232, 185, 185);
}

/* 🟢 난이도 1: 하 (입문) - 고급 매트 에메랄드 그린 */
.theme-diff-easy {
    --theme-primary: rgb(21, 115, 85);
    --theme-primary-dark: rgb(15, 88, 65);
    --theme-primary-light: rgb(45, 150, 115);
    --theme-primary-bg: rgb(242, 248, 245);
    --theme-primary-tint: rgb(225, 240, 233);
    --theme-primary-border: rgb(150, 205, 180);
    --theme-primary-hover: rgba(21, 115, 85, 0.12);
    --theme-primary-move: rgba(21, 115, 85, 0.28);
    --theme-primary-move-hover: rgba(21, 115, 85, 0.55);
    --theme-screen-bg: rgb(246, 250, 248);
    --theme-board-bg: #EEF5F1;
    --theme-board-border: rgb(21, 115, 85);
    --theme-board-shadow: rgb(15, 88, 65);
    --theme-board-line: rgb(55, 115, 90);
}

/* 🔵 난이도 2: 중 (보통) - 선명하고 매트한 클래식 사파이어 블루 (기본값) */
.theme-diff-normal {
    --theme-primary: rgb(29, 116, 178);
    --theme-primary-dark: rgb(21, 88, 140);
    --theme-primary-light: rgb(70, 148, 208);
    --theme-primary-bg: rgb(242, 247, 252);
    --theme-primary-tint: rgb(224, 238, 248);
    --theme-primary-border: rgb(165, 202, 230);
    --theme-primary-hover: rgba(29, 116, 178, 0.12);
    --theme-primary-move: rgba(29, 116, 178, 0.28);
    --theme-primary-move-hover: rgba(29, 116, 178, 0.55);
    --theme-screen-bg: rgb(246, 248, 251);
    --theme-board-bg: #EDF3F8;
    --theme-board-border: rgb(29, 116, 178);
    --theme-board-shadow: rgb(21, 88, 140);
    --theme-board-line: rgb(75, 122, 162);
}

/* 🟣 난이도 3: 상 (숙련) - 깊이 있고 차분한 딥 매트 로열 바이올렛 */
.theme-diff-hard {
    --theme-primary: rgb(112, 44, 168);
    --theme-primary-dark: rgb(85, 28, 130);
    --theme-primary-light: rgb(155, 95, 208);
    --theme-primary-bg: rgb(249, 246, 252);
    --theme-primary-tint: rgb(240, 232, 248);
    --theme-primary-border: rgb(210, 185, 232);
    --theme-primary-hover: rgba(112, 44, 168, 0.12);
    --theme-primary-move: rgba(112, 44, 168, 0.28);
    --theme-primary-move-hover: rgba(112, 44, 168, 0.55);
    --theme-screen-bg: rgb(250, 248, 252);
    --theme-board-bg: #EFEBF5;
    --theme-board-border: rgb(112, 44, 168);
    --theme-board-shadow: rgb(85, 28, 130);
    --theme-board-line: rgb(125, 78, 165);
}

/* 🌌 난이도 4: 극악 (신) - 미드나잇 건메탈 & 다크 티타늄 테마 */
.theme-diff-hell {
    --theme-primary: rgb(39, 45, 60);
    --theme-primary-dark: rgb(21, 25, 36);
    --theme-primary-light: rgb(79, 88, 110);
    --theme-primary-bg: rgb(241, 243, 249);
    --theme-primary-tint: rgb(225, 229, 238);
    --theme-primary-border: rgb(201, 207, 220);
    --theme-primary-hover: rgba(39, 45, 60, 0.15);
    --theme-primary-move: rgba(39, 45, 60, 0.35);
    --theme-primary-move-hover: rgba(39, 45, 60, 0.65);
    --theme-screen-bg: rgb(246, 248, 252);
    --theme-board-bg: rgb(208, 216, 230);
    --theme-board-border: rgb(45, 55, 75);
    --theme-board-shadow: rgb(15, 20, 30);
    --theme-board-line: rgb(55, 68, 90);
}

/* ── 최상위 루트 컨테이너 및 폰트 설정 (가평한석봉체 Regular) ── */
* {
    margin: 0;
    padding: 0;
    -unity-font: url("project://database/Assets/Font/GapyeongHanseokbongR.ttf?fileID=12800000&guid=ca93051617e4d47318abb40ecfb673bd&type=3#GapyeongHanseokbongR");
    -unity-font-definition: url("project://database/Assets/Font/GapyeongHanseokbongR.ttf?fileID=12800000&guid=ca93051617e4d47318abb40ecfb673bd&type=3#GapyeongHanseokbongR");
}

Label, Button, TextField {
    -unity-font: url("project://database/Assets/Font/GapyeongHanseokbongR.ttf?fileID=12800000&guid=ca93051617e4d47318abb40ecfb673bd&type=3#GapyeongHanseokbongR");
    -unity-font-definition: url("project://database/Assets/Font/GapyeongHanseokbongR.ttf?fileID=12800000&guid=ca93051617e4d47318abb40ecfb673bd&type=3#GapyeongHanseokbongR");
}

.root-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    background-color: var(--theme-screen-bg);
    padding: 0;
}

.screen-container {
    width: 100%;
    height: 100%;
}

/* ══════════════════════════════════════════ */
/* 1. 메인 메뉴 화면 (Main Menu Styles) */
/* ══════════════════════════════════════════ */

.main-menu-screen {
    align-items: center;
    justify-content: space-around;
    padding: 36px 20px;
    background-color: var(--theme-screen-bg);
}

.menu-title-area {
    align-items: center;
    margin-bottom: 16px;
}

.menu-title-hanja {
    font-size: 72px;
    color: var(--theme-primary);
    -unity-font-style: bold;
    letter-spacing: 22px;
    margin-bottom: -4px;
}

.menu-title-korean {
    font-size: 34px;
    color: rgb(30, 41, 59);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 6px;
}

.menu-subtitle {
    font-size: 16px;
    color: rgb(100, 116, 139);
    -unity-font-style: bold;
}

/* ── 난이도 선택 영역 ── */
.difficulty-section {
    width: 100%;
    max-width: 580px;
    align-items: center;
    margin-bottom: 16px;
}

.section-title {
    font-size: 20px;
    color: rgb(51, 65, 85);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.difficulty-grid {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.diff-card-wrapper {
    position: relative;
    width: 100%;
    height: 96px;
    margin-bottom: 12px;
}

.diff-card-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 5px;
    border-radius: 14px;
    background-color: rgb(203, 213, 225);
    border-width: 0;
}

.diff-card-wrapper--selected .diff-card-shadow {
    background-color: var(--theme-primary-dark);
}

.diff-card {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2px;
    border-radius: 14px;
    padding: 12px 14px;
    justify-content: space-evenly;
    flex-direction: row;
    align-items: center;
    transition-property: translate, border-color, background-color;
    transition-duration: 0.1s, 0.1s, 0.1s;
}

.diff-card:hover {
    background-color: var(--theme-primary-bg);
    border-color: var(--theme-primary-light);
    translate: 0 -2px;
}

.diff-card-wrapper--selected .diff-card {
    background-color: var(--theme-primary-tint);
    border-color: var(--theme-primary);
    border-width: 2px;
}

.diff-card-title {
    font-size: 25px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    align-self: center;
}

.diff-title-easy {
    color: rgb(21, 115, 85);
}

.diff-title-normal {
    color: rgb(29, 116, 178);
}

.diff-title-hard {
    color: rgb(112, 44, 168);
}

.diff-title-hell {
    color: rgb(39, 45, 60);
}

.diff-card-desc {
    font-size: 21px;
    color: rgb(100, 116, 139);
    -unity-text-align: middle-center;
}

/* ── 메인 액션 버튼 ── */
.menu-action-area {
    width: 100%;
    max-width: 480px;
    align-items: center;
}

.menu-btn-wrapper {
    position: relative;
    width: 100%;
    height: 82px;
    margin: 6px 0;
}

.menu-btn-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 6px;
    border-radius: 16px;
    border-width: 0;
}

.menu-btn-shadow-start {
    background-color: var(--theme-primary-dark);
}

.menu-btn-shadow-rules {
    background-color: rgb(203, 213, 225);
}

.menu-btn-shadow-language {
    background-color: rgb(203, 213, 225);
}

.menu-btn {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 14px 0;
    font-size: 30px;
    -unity-font-style: bold;
    border-radius: 16px;
    margin: 0;
    -unity-text-align: middle-center;
    transition-property: translate;
    transition-duration: 0.08s;
}

.menu-btn-start {
    background-color: var(--theme-primary);
    border-color: var(--theme-primary-light);
    border-width: 2px;
    color: rgb(255, 255, 255);
}

.menu-btn-start:hover {
    background-color: var(--theme-primary-dark);
    translate: 0 -2px;
}

.menu-btn-start:active {
    translate: 0 4px;
}

.menu-btn-rules {
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2px;
    color: rgb(51, 65, 85);
    font-size: 24px;
}

.menu-btn-rules:hover {
    background-color: var(--theme-primary-bg);
    border-color: var(--theme-primary-light);
    translate: 0 -2px;
}

.menu-btn-rules:active {
    translate: 0 4px;
}

.menu-btn-shadow-haptic {
    background-color: rgb(203, 213, 225);
}

.menu-btn-haptic {
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2px;
    color: rgb(51, 65, 85);
    font-size: 21px;
}

.menu-btn-haptic:hover {
    background-color: var(--theme-primary-bg);
    border-color: var(--theme-primary-light);
    translate: 0 -2px;
}

.menu-btn-haptic:active {
    translate: 0 4px;
}

.menu-btn-language {
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2px;
    color: rgb(51, 65, 85);
    font-size: 21px;
}

.menu-btn-language:hover {
    background-color: var(--theme-primary-bg);
    border-color: var(--theme-primary-light);
    translate: 0 -2px;
}

.menu-btn-language:active {
    translate: 0 4px;
}

/* ══════════════════════════════════════════ */
/* 2. 인게임 플레이 화면 (Game Play Styles) */
/* ══════════════════════════════════════════ */

.game-play-screen {
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    margin: 0;
}

/* ── 헤더 영역 ── */
.header {
    width: 100%;
    max-width: 1020px;
    align-items: center;
    margin-bottom: 30px;
    flex-shrink: 0;
}

.header-top-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: 2px;
}

.header-top-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 4px;
    border-radius: 14px;
    background-color: rgb(203, 213, 225);
    border-width: 0;
}

.header-top {
    position: relative;
    height: 75px;
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2px;
    border-radius: 14px;
    padding: 8px 14px;
}

.header-buttons {
    height: 100%;
    flex-direction: row;
    font-size: 21px;
    align-items: stretch;
}

.game-title {
    font-size: 24px;
    color: rgb(30, 41, 59);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

/* ── 일시정지 버튼 ── */
.pause-button-container {
    position: relative;
    top: 0;
}

.pause-btn {
    width: auto;
    padding: 0 16px;
    height: 100%;
    border-radius: 12px;
    font-size: 24px;
    color: rgb(51, 65, 85);
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2px;
    justify-content: center;
    align-items: center;
    transition-property: scale, background-color;
    transition-duration: 0.1s, 0.1s;
    margin: 0;
}

.pause-btn:hover {
    background-color: rgb(241, 245, 249);
    scale: 1.05;
}

.pause-btn:active {
    scale: 0.95;
}

/* ── 일시정지 모달 카드 ── */
.pause-modal-card {
    padding: 24px;
    align-items: center;
}

/* (Turn-info 텍스트 제거됨 - 보드 색상으로 턴 구분) */

/* ── 플레이어 / AI 패널 ── */
.player-panel-wrapper {
    position: relative;
    width: 100%;
    height: 210px;
    max-width: 1020px;
    margin: 3px 0;
    flex-shrink: 0;
}

.player-panel-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 6px;
    border-radius: 16px;
    border-width: 0;
}

.han-panel-shadow {
    background-color: var(--theme-han-primary);
}

.cho-panel-shadow {
    background-color: var(--theme-primary);
}

.player-panel {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    border-radius: 16px;
    border-width: 2px;
    padding: 8px 12px;
}

.han-panel {
    border-color: var(--theme-han-border);
}

.cho-panel {
    border-color: var(--theme-primary-border);
}

.panel-status-row {
    position: relative;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 50px;
    flex-shrink: 0;
}

.han-status-row {
    margin-top: 6px;
    margin-bottom: 0px;
}

.cho-panel .panel-status-row {
    margin-top: 0px;
    margin-bottom: 6px;
}

.discard-btn-spacer {
    width: 195px;
}

.side-label {
    font-size: 25px;
    -unity-font-style: bold;
}

.han-label {
    color: rgb(220, 38, 38);
}

.cho-label {
    color: var(--theme-primary);
}

/* ── 코스트 & 전력 메트릭스 박스 (패널 가로 정중앙 배치) ── */
.panel-metrics {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.cost-box {
    background-color: var(--theme-primary-bg);
    border-color: var(--theme-primary-border);
    border-width: 2px;
    border-radius: 8px;
    padding: 3px 8px;
}

.field-box {
    margin-left: 6px;
    background-color: rgb(240, 253, 244);
    border-color: rgb(187, 247, 208);
}

.cost-label {
    font-size: 22px;
    color: var(--theme-primary);
    -unity-font-style: bold;
}

.field-label {
    color: rgb(22, 163, 74);
}

/* ── 漢 패널 텍스트/박스 ── */
.han-panel .cost-box {
    background-color: var(--theme-han-bg);
    border-color: var(--theme-han-border);
}

.han-panel .field-box {
    background-color: rgb(255, 247, 237);
    border-color: rgb(254, 215, 170);
}

.han-panel .cost-label {
    color: var(--theme-han-primary);
}

.han-panel .field-label {
    color: rgb(234, 88, 12);
}

.han-panel .card-cost-badge {
    background-color: var(--theme-han-primary);
}

.han-panel .card-name-label {
    color: var(--theme-han-dark);
}

/* ── 손패 카드 컨테이너 ── */
.hand-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    flex-grow: 1;
    flex-shrink: 0;
    height: 132px;
    min-height: 132px;
    max-height: 132px;
}

.hand-card-wrapper {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    height: 100%;
    margin: 0 4px;
}

.hand-card-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 5px;
    border-radius: 12px;
    border-width: 0;
}

.hand-card-shadow-cho {
    background-color: var(--theme-primary);
}

.hand-card-shadow-han {
    background-color: var(--theme-han-primary);
}

.hand-card-shadow--selected {
    background-color: var(--theme-primary-dark);
}

.hand-card-shadow--discard {
    background-color: var(--theme-han-primary);
}

.hand-card {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    border-color: var(--theme-primary);
    border-width: 2px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    padding-left: 38px;
}

.han-panel .hand-card {
    border-color: var(--theme-han-primary);
}

.hand-card:hover {
    background-color: var(--theme-primary-bg);
}

.han-panel .hand-card:hover {
    background-color: var(--theme-han-bg);
    translate: 0 0;
}

.hand-card--selected {
    border-color: var(--theme-primary);
    background-color: var(--theme-primary-tint);
    translate: 0 -2px;
}

.hand-card--discard-target {
    border-color: rgb(220, 38, 38);
    border-width: 2.5px;
    background-color: rgb(254, 226, 226);
    translate: 0 -2px;
}

.hand-card--unusable {
    /* 카드 자체의 불투명도는 100% 유지 (뒤 섀도우 박스 투과 방지) */
}

/* ── 소환 불가 전용 딤드 오버레이 엘리먼트 ── */
.hand-card-disabled-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.65);
    pointer-events: none;
}

/* 카드 좌측 코스트 배지 */
.card-cost-badge {
    position: absolute;
    top: 0px;
    left: 0px;
    bottom: 0px;
    background-color: var(--theme-primary);
    border-radius: 10px 0 0 10px;
    padding: 0px;
    width: 38px;
    align-items: center;
    justify-content: center;
}

.han-panel .card-cost-badge {
    background-color: var(--theme-han-primary);
}

.card-cost-text {
    font-size: 21px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 카드 중앙 기물 한자 */
.card-piece-label {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.card-piece-cho {
    color: var(--theme-primary);
}

.card-piece-han {
    color: var(--theme-han-primary);
}

/* 카드 하단 역할/이름 텍스트 */
.card-name-label {
    font-size: 22px;
    color: rgb(100, 116, 139);
    -unity-font-style: bold;
}

/* ── 패 버리기 & 한 수 쉼 & 광고 찬스 액션 바 (좌우 배치) ── */
.cho-action-bar {
    position: relative;
    width: 100%;
    max-width: 1020px;
    height: 56px;
    min-height: 56px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px;
    margin: 4px 0;
    flex-shrink: 0;
}

.action-btn-group-left {
    flex-direction: row;
    align-items: center;
}

.action-btn-group-right {
    flex-direction: row;
    align-items: center;
}

.action-btn-wrapper {
    position: relative;
    height: 44px;
    justify-content: center;
}

.action-btn-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 5px;
    border-radius: 10px;
    border-width: 0;
}

.discard-btn-shadow {
    background-color: rgb(203, 213, 225);
}

.pass-btn-shadow {
    background-color: var(--theme-primary-dark);
}

.ad-chance-btn-shadow {
    background-color: rgb(180, 83, 9);
}

.ad-chance-btn-shadow--disabled {
    background-color: rgb(15, 23, 42);
}

.action-btn {
    position: relative;
    padding: 6px 18px;
    font-size: 25px;
    -unity-font-style: bold;
    border-radius: 10px;
    border-width: 2px;
    align-items: center;
    justify-content: center;
    margin: 0;
    transition-property: translate, background-color, border-color, color;
    transition-duration: 0.08s, 0.08s, 0.08s, 0.08s;
}

/* 패 버리기 버튼 */
.discard-btn {
    color: rgb(51, 65, 85);
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
}

.discard-btn:hover {
    background-color: rgb(241, 245, 249);
    border-color: rgb(148, 163, 184);
}

.discard-btn:active {
    translate: 0 3px;
}

.discard-btn--active {
    background-color: rgb(220, 38, 38);
    border-color: rgb(185, 28, 28);
    color: rgb(255, 255, 255);
}

.discard-btn--active:hover {
    background-color: rgb(185, 28, 28);
    border-color: rgb(153, 27, 27);
}

/* 한 수 쉼 버튼 */
.pass-btn {
    color: rgb(255, 255, 255);
    background-color: var(--theme-primary);
    border-color: var(--theme-primary-light);
}

.pass-btn:hover {
    background-color: var(--theme-primary-dark);
    border-color: var(--theme-primary);
}

.pass-btn:active {
    translate: 0 3px;
}

/* 광고 찬스 버튼 */
.ad-chance-btn {
    color: rgb(255, 255, 255);
    background-color: rgb(245, 158, 11);
    border-color: rgb(251, 191, 36);
}

.ad-chance-btn:hover {
    background-color: rgb(217, 119, 6);
    border-color: rgb(245, 158, 11);
}

.ad-chance-btn:active {
    translate: 0 3px;
}

.ad-chance-btn--active {
    background-color: rgb(220, 38, 38);
    border-color: rgb(248, 113, 113);
    color: rgb(255, 255, 255);
}

.ad-chance-btn--disabled {
    opacity: 1;
    background-color: rgb(30, 41, 59);
    border-color: rgb(15, 23, 42);
    color: rgb(100, 116, 139);
}

.ad-chance-btn--disabled:hover {
    background-color: rgb(30, 41, 59);
    border-color: rgb(15, 23, 42);
}

.ad-chance-btn--disabled:active {
    translate: 0 0;
}

/* ── 중앙 보드 영역 ── */
.board-area {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    max-width: 1020px;
    margin: 4px 0;
}

.board-wrapper {
    position: relative;
    width: 100%;
}

.board-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 8px;
    border-radius: 18px;
    background-color: var(--theme-board-shadow);
    border-width: 0;
    transition-property: background-color;
    transition-duration: 0.25s;
}

.board-container {
    position: relative;
    width: 100%;
    background-color: var(--theme-board-bg);
    border-color: var(--theme-board-border);
    border-width: 3px;
    border-radius: 18px;
    overflow: hidden;
    transition-property: background-color, border-color;
    transition-duration: 0.25s;
}

/* ── 격자 배경 & 교차점 ── */
.grid-background {
    position: absolute;
    left: 2%;
    top: 2%;
    right: 2%;
    bottom: 2%;
}

.grid-line-h {
    position: absolute;
    left: 5.5555%;
    right: 5.5555%;
    height: 2px;
    translate: 0 -1px;
    background-color: var(--theme-board-line);
    transition-property: background-color;
    transition-duration: 0.25s;
}

.grid-line-v {
    position: absolute;
    top: 5%;
    bottom: 5%;
    width: 2px;
    translate: -1px 0;
    background-color: var(--theme-board-line);
    transition-property: background-color;
    transition-duration: 0.25s;
}

/* 🔴 AI(漢) 턴일 때 보드판 색상 - 붉은색/루비/크림슨 계열 */
.turn-han .board-container {
    background-color: rgb(252, 232, 232);
    border-color: rgb(239, 68, 68);
}

.turn-han .board-shadow {
    background-color: rgb(185, 28, 28);
}

.turn-han .grid-line-h,
.turn-han .grid-line-v {
    background-color: rgb(220, 100, 100);
}

.intersections-grid {
    position: absolute;
    left: 2%;
    top: 2%;
    right: 2%;
    bottom: 2%;
    flex-direction: column;
}

.board-row {
    flex-direction: row;
    width: 100%;
    height: 10%;
    align-items: center;
    justify-content: flex-start;
}

.intersection {
    width: 11.1111%;
    height: 100%;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    position: relative;
}

.intersection:hover {
    background-color: var(--theme-primary-hover);
    border-radius: 50%;
}

/* ── 기물 섀도우 엘리먼트 ── */
.piece-shadow {
    position: absolute;
    width: 86%;
    height: 86%;
    background-color: transparent;
    translate: 0 7px;
    border-width: 0;
    transition-property: translate;
    transition-duration: 0.12s;
}

.piece-shadow-cho {
    -unity-background-image-tint-color: var(--theme-primary);
}

.piece-shadow-han {
    -unity-background-image-tint-color: var(--theme-han-primary);
}

/* ── 기물 본체 ── */
.piece {
    position: relative;
    width: 86%;
    height: 86%;
    border-width: 0;
    --hex-border-width: 2;
    background-color: transparent;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 28px;
    -unity-font-style: bold;
    transition-property: translate;
    transition-duration: 0.12s;
}

/* 초(楚) 기물 */
.piece-cho {
    color: var(--theme-primary);
    --hex-border-color: var(--theme-primary-border);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* 한(漢) 기물 */
.piece-han {
    color: var(--theme-han-primary);
    --hex-border-color: var(--theme-han-border);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* 기물 상태 하이라이트 & 선택 시 Y축 리프팅(-5px, 본체와 섀도우 함께 이동) */
.intersection--selected {
    background-color: rgba(250, 204, 21, 0.45);
    border-radius: 50%;
    border-width: 2px;
    border-color: rgb(202, 138, 4);
}

.intersection--selected .piece {
    translate: 0 -3px;
}

.intersection--selected .piece-shadow {
    translate: 0 4px;
}

.intersection--movable {
    background-color: var(--theme-primary-move);
    border-radius: 50%;
}

.intersection--movable:hover {
    background-color: var(--theme-primary-move-hover);
}

.intersection--attackable {
    background-color: rgba(220, 38, 38, 0.45);
    border-radius: 50%;
    border-width: 2px;
    border-color: rgb(220, 38, 38);
}

.intersection--attackable:hover {
    background-color: rgba(220, 38, 38, 0.7);
}

.intersection--spawnable {
    background-color: var(--theme-primary-move);
    border-width: 2px;
    border-color: var(--theme-primary);
    border-radius: 50%;
}

.intersection--spawnable:hover {
    background-color: var(--theme-primary-move-hover);
}

.intersection--check {
    background-color: rgba(220, 38, 38, 0.45);
    border-radius: 50%;
}

.intersection--last-from {
    background-color: rgba(250, 204, 21, 0.35);
    border-radius: 50%;
}

.intersection--eliminate-target {
    background-color: rgba(239, 68, 68, 0.5);
    border-radius: 50%;
    border-width: 3px;
    border-color: rgb(239, 68, 68);
    transition-property: scale;
    transition-duration: 0.15s;
}

.intersection--eliminate-target:hover {
    background-color: rgba(220, 38, 38, 0.85);
    scale: 1.12 1.12;
}

.intersection--eliminate-target .piece {
    border-color: rgb(239, 68, 68);
    border-width: 3px;
    background-color: rgb(254, 226, 226);
    color: rgb(185, 28, 28);
    scale: 1.15 1.15;
    translate: 0 -4px;
}

.intersection--eliminate-target .piece-shadow {
    scale: 1.15 1.15;
    translate: 0 4px;
}

/* ── 광고 시청 모달 ── */
.ad-modal-badge {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(217, 119, 6);
    background-color: rgb(254, 243, 199);
    border-color: rgb(252, 211, 77);
    border-width: 1.5px;
    border-radius: 20px;
    padding: 4px 12px;
}

.ad-progress-bar-fill {
    transition-property: width;
    transition-duration: 1.2s;
    transition-timing-function: ease-out;
}

/* ── 유틸 버튼 ── */
.control-btn {
    padding: 6px 12px;
    font-size: 15px;
    color: rgb(51, 65, 85);
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 1.5px;
    border-radius: 10px;
    -unity-font-style: bold;
    transition-property: translate;
    transition-duration: 0.08s;
}

.control-btn:hover {
    background-color: rgb(248, 250, 252);
    translate: 0 -1px;
}

.control-btn:active {
    translate: 0 2px;
}

.btn-sm {
    padding: 5px 10px;
    font-size: 21px;
}

.btn-difficulty {
    margin-right: 6px;
    color: var(--theme-primary-dark);
    background-color: var(--theme-primary-bg);
    border-color: var(--theme-primary-border);
}

.btn-difficulty:hover {
    background-color: var(--theme-primary-tint);
}

.btn-language {
    margin-right: 6px;
    color: rgb(51, 65, 85);
    background-color: rgb(248, 250, 252);
    border-color: rgb(226, 232, 240);
}

.btn-language:hover {
    background-color: rgb(241, 245, 249);
}

.btn-menu {
    margin-left: 6px;
    color: rgb(100, 116, 139);
}

/* ══════════════════════════════════════════ */
/* 3. 모달 팝업 공통 */
/* ══════════════════════════════════════════ */

.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.72);
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.modal-card-wrapper {
    position: relative;
    width: 86%;
    max-width: 1000px;
}

.modal-card-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 6px;
    border-radius: 20px;
    background-color: rgb(203, 213, 225);
    border-width: 0;
}

.modal-card {
    position: relative;
    width: 100%;
    background-color: rgb(255, 255, 255);
    border-color: rgb(226, 232, 240);
    border-width: 2.5px;
    border-radius: 20px;
    padding: 28px 22px;
    align-items: center;
}

.modal-title {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 6px;
}

.modal-title--win {
    color: var(--theme-primary);
}

.modal-title--lose {
    color: rgb(220, 38, 38);
}

.modal-title--draw {
    color: rgb(100, 116, 139);
}

.modal-desc {
    font-size: 17px;
    color: rgb(100, 116, 139);
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}

.modal-stats {
    width: 100%;
    background-color: rgb(248, 250, 252);
    border-color: rgb(226, 232, 240);
    border-width: 1.5px;
    border-radius: 14px;
    padding: 12px 14px;
    margin-bottom: 20px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 4px 0;
}

.stat-label {
    font-size: 15px;
    color: rgb(100, 116, 139);
    -unity-font-style: bold;
}

.stat-value {
    color: rgb(51, 65, 85);
    -unity-font-style: bold;
}

.modal-btn-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 4px;
    border-radius: 14px;
    border-width: 0;
}

.modal-btn-shadow-share {
    background-color: rgb(202, 138, 4);
}

.modal-btn-shadow-ad {
    background-color: rgb(190, 95, 10);
}

.modal-btn-shadow-primary {
    background-color: var(--theme-primary-dark);
}

.modal-btn-shadow-secondary {
    background-color: rgb(203, 213, 225);
}

.modal-btn {
    position: relative;
    width: 100%;
    height: 100%;
    font-size: 22px;
    -unity-font-style: bold;
    border-radius: 14px;
    margin: 0;
    -unity-text-align: middle-center;
    transition-property: translate;
    transition-duration: 0.08s;
}

.modal-btn:active {
    translate: 0 3px;
}

.modal-btn-share {
    background-color: rgb(254, 240, 138);
    border-color: rgb(234, 179, 8);
    border-width: 1.5px;
    color: rgb(113, 63, 18);
}

.modal-btn-share:hover {
    background-color: rgb(253, 224, 71);
    translate: 0 -1px;
}

.modal-btn-ad {
    background-color: rgb(245, 158, 11);
    border-color: rgb(251, 191, 36);
    border-width: 1.5px;
    color: rgb(255, 255, 255);
}

.modal-btn-ad:hover {
    background-color: rgb(217, 119, 6);
    translate: 0 -1px;
}

.modal-btn-shadow-review {
    background-color: rgb(30, 64, 175);
}

.modal-btn-review {
    background-color: rgb(37, 99, 235);
    border-color: rgb(96, 165, 250);
    border-width: 1.5px;
    color: rgb(255, 255, 255);
}

.modal-btn-review:hover {
    background-color: rgb(29, 78, 216);
    translate: 0 -1px;
}

.modal-btn-primary {
    background-color: var(--theme-primary);
    border-color: var(--theme-primary-light);
    border-width: 1.5px;
    color: rgb(255, 255, 255);
}

.modal-btn-primary:hover {
    background-color: var(--theme-primary-dark);
    translate: 0 -1px;
}

.modal-btn-secondary {
    background-color: rgb(248, 250, 252);
    border-color: rgb(226, 232, 240);
    border-width: 1.5px;
    color: rgb(51, 65, 85);
}

.modal-btn-secondary:hover {
    background-color: rgb(241, 245, 249);
    translate: 0 -1px;
}

/* ── 4. 게임 오버 인라인 결과창 (보드 아래 공간 배치) ── */
.game-play-screen.state--game-over .han-panel-wrapper,
.game-play-screen.state--game-over .cho-panel-wrapper,
.game-play-screen.state--game-over .cho-action-bar {
    display: none;
}

.game-play-screen.state--game-over .board-area {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: 4px;
}

.game-over-inline-area {
    position: relative;
    width: 100%;
    max-width: 1020px;
    margin: 30px 0 20px 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.game-over-inline-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    translate: 0 6px;
    border-radius: 18px;
    background-color: var(--theme-primary-dark);
    border-width: 0;
}

.game-over-inline-card {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    border-radius: 18px;
    border-width: 2.5px;
    border-color: var(--theme-primary-border);
    padding: 10px 14px;
    flex-direction: column;
    justify-content: space-between;
}

.inline-title-row {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
}

.inline-modal-title {
    font-size: 40px;
    -unity-font-style: bold;
    margin: 8px 0;
}

.inline-modal-title--win {
    color: rgb(5, 150, 105);
}

.inline-modal-title--lose {
    color: rgb(220, 38, 38);
}

.inline-modal-title--draw {
    color: rgb(217, 119, 6);
}

.inline-modal-badge {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: var(--theme-primary);
    border-radius: 12px;
    padding: 4px 10px;
}

/* 외통수 분석 섹션 */
.inline-review-section {
    background-color: var(--theme-primary-bg);
    border-radius: 12px;
    border-width: 1.5px;
    border-color: var(--theme-primary-border);
    padding: 8px 40px;
    margin-bottom: 6px;
}

.inline-review-desc {
    font-size: 30px;
    color: rgb(30, 41, 59);
    white-space: normal;
    -unity-font-style: normal;
    line-height: 19px;
}

/* 통계 2x2 그리드 */
.inline-stats-grid {
    flex-direction: column;
    margin-bottom: 6px;
}

.inline-stats-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 60px;
}

.inline-stat-chip {
    flex: 1;
    height: 100%;
    background-color: rgb(248, 250, 252);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(226, 232, 240);
    padding: 6px 12px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.inline-chip-label {
    font-size: 22px;
    color: rgb(100, 116, 139);
    -unity-font-style: bold;
}

.inline-chip-value {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
}

/* 액션 버튼 행 */
.inline-actions-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 55px;
}

.inline-btn-wrapper {
    flex: 1;
    height: 100%;
}

.inline-action-btn {
    font-size: 23px;
    border-radius: 12px;
}

/* ── 복기/외통수 시각적 하이라이트 (기물 본연의 색상과 폰트 보존) ── */
.intersection--review-attacker {
    background-color: rgba(239, 68, 68, 0.3);
    border-radius: 50%;
    border-width: 3px;
    border-color: rgb(239, 68, 68);
}

.intersection--review-attacker .piece {
    translate: 0 -3px;
}

.intersection--review-controller {
    background-color: rgba(147, 51, 234, 0.25);
    border-radius: 50%;
    border-width: 2.5px;
    border-color: rgb(147, 51, 234);
}

.intersection--review-target-king {
    background-color: rgba(220, 38, 38, 0.45);
    border-radius: 50%;
    border-width: 3.5px;
    border-color: rgb(220, 38, 38);
}

.intersection--review-target-king .piece {
    translate: 0 -4px;
}

.intersection--review-blocked-pos {
    background-color: rgba(239, 68, 68, 0.22);
    border-radius: 50%;
    border-width: 2px;
    border-color: rgba(220, 38, 38, 0.6);
}

/* ── 룰 가이드 모달 ── */
.rule-modal-card {
    width: 100%;
    max-height: 100%;
}

.rule-scroll-view {
    width: 100%;
    max-height: 100%;
    margin-bottom: 18px;
}

.rule-item {
    background-color: rgb(248, 250, 252);
    border-color: rgb(226, 232, 240);
    border-width: 1.5px;
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 10px;
}

.rule-item-title {
    font-size: 25px;
    color: var(--theme-primary);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.rule-item-desc {
    font-size: 22px;
    color: rgb(51, 65, 85);
    white-space: normal;
}

/* ══════════════════════════════════════════ */
/* 4. 장군 / 멍군 다이내믹 알림 배너 */
/* ══════════════════════════════════════════ */

.callout-banner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    z-index: 95;
    pointer-events: none;
    flex-shrink: 0;
    background-color: rgba(11, 19, 43, 0.58);
    transition-property: opacity, background-color;
    transition-duration: 0.22s, 0.22s;
    transition-timing-function: ease-out, ease-out;
}

.callout-banner--hidden {
    opacity: 0;
    display: none;
}

.callout-banner--hidden .callout-card-frame {
    scale: 0.45 0.45;
    opacity: 0;
}

/* ══════════════════════════════════════════ */
/* 기물 애니메이션 전용 레이어 (Piece Animation Layer) */
/* ══════════════════════════════════════════ */

.piece-layer {
    position: absolute;
    left: 2%;
    top: 2%;
    right: 2%;
    bottom: 2%;
    /* 이벤트 뚫기 (클릭은 아래의 intersection이 처리함) */
    picking-mode: ignore;
}

.piece-container {
    position: absolute;
    /* 폭은 100% / 9열 = 약 11.111%, 높이는 100% / 10행 = 10% */
    width: 11.111%;
    height: 10%;
    align-items: center;
    justify-content: center;
    picking-mode: ignore;
    transition-property: left, top, scale, opacity;
    transition-duration: 0.2s, 0.2s, 0.18s, 0.18s;
    transition-timing-function: ease-out, ease-out, ease-out-back, linear;
}

.piece-container--selected {
    scale: 1.15;
}

.piece-container--enter {
    scale: 0.1;
    opacity: 0;
}

.piece-container--exit {
    scale: 1.2;
    opacity: 0;
}

/* 기물 이동 중 3D 리프팅(살짝 떠오름) 효과 */
.piece-container--moving {
    scale: 1.15;
}

/* 기물 착지 시 순간적인 쫀득한 슬램(탁!) 바운스 효과 */
.piece-container--slam {
    scale: 0.94;
}

/* ══════════════════════════════════════════ */
/* 이동 연출 (Departure Ring & Landing Shockwave) */
/* ══════════════════════════════════════════ */

/* 1. 출발 위치 잔상 링 (Departure Ring) */
.move-departure-ring {
    position: absolute;
    width: 11.111%;
    height: 10%;
    border-radius: 50%;
    border-width: 2.5px;
    border-color: rgba(255, 255, 255, 0.7);
    background-color: rgba(255, 255, 255, 0.08);
    scale: 0.7;
    opacity: 0.9;
    align-items: center;
    justify-content: center;
    picking-mode: ignore;
    transition-property: scale, opacity, border-color;
    transition-duration: 0.28s, 0.28s, 0.28s;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.move-departure-ring--play {
    scale: 1.45;
    opacity: 0;
    border-color: rgba(255, 255, 255, 0);
}

/* 2. 도착 위치 착지 충격파 (Landing Shockwave) */
.move-landing-shockwave {
    position: absolute;
    width: 11.111%;
    height: 10%;
    border-radius: 50%;
    border-width: 3.5px;
    border-color: rgba(255, 255, 255, 0.9);
    background-color: rgba(255, 255, 255, 0.15);
    scale: 0.25;
    opacity: 1;
    align-items: center;
    justify-content: center;
    picking-mode: ignore;
    transition-property: scale, opacity, border-color, background-color;
    transition-duration: 0.32s, 0.32s, 0.32s, 0.32s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

.move-landing-shockwave--play {
    scale: 1.85;
    opacity: 0;
    border-color: rgba(255, 255, 255, 0);
    background-color: rgba(255, 255, 255, 0);
}

/* 착지 중심부 스파크 코어 */
.move-landing-core {
    width: 45%;
    height: 45%;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.9);
    scale: 1.2;
    opacity: 1;
    transition-property: scale, opacity;
    transition-duration: 0.24s, 0.24s;
    transition-timing-function: ease-out, ease-out;
}

.move-landing-shockwave--play .move-landing-core {
    scale: 0.1;
    opacity: 0;
}

/* 착지 임팩트 기본 리플 (호환용) */
.impact-ripple {
    position: absolute;
    width: 11.111%;
    height: 10%;
    border-radius: 50%;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.8);
    scale: 0.2;
    opacity: 1;
    picking-mode: ignore;
    transition-property: scale, opacity, border-color;
    transition-duration: 0.3s, 0.3s, 0.3s;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.impact-ripple--play {
    scale: 1.6;
    opacity: 0;
    border-color: rgba(255, 255, 255, 0);
}

/* ══════════════════════════════════════════ */
/* 고급 이펙트 (Shake, Vignette, Slash, Glow) */
/* ══════════════════════════════════════════ */

/* 1. 보드 흔들림 (Screen Shake) */
.board-shake {
    translate: 6px 6px;
}

/* 2. 장군 경고 테두리 (Check Vignette) */
.danger-vignette {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    picking-mode: ignore;
    opacity: 0;
    border-color: rgba(255, 30, 30, 0.8);
    border-width: 8px;
    border-radius: 18px;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
}
.danger-vignette--active {
    opacity: 1;
}

/* 3. 고급 타격 베기 이펙트 (Crescent Slash) */
.capture-slash {
    position: absolute;
    width: 11.111%;
    height: 10%;
    background-color: transparent;
    /* 상단과 하단 보더만 주어 초승달(Crescent)/검기 형태를 만듭니다 */
    border-top-width: 6px;
    border-top-color: rgba(255, 40, 40, 1);
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 200, 200, 0.8);
    border-radius: 50%;
    rotate: -30deg;
    scale: 0.2 0.2;
    opacity: 1;
    picking-mode: ignore;
    transition-property: scale, opacity, rotate;
    transition-duration: 0.35s, 0.35s, 0.35s;
    transition-timing-function: ease-out, ease-in, ease-out;
}
.capture-slash--play {
    scale: 3.5 0.15;
    opacity: 0;
    rotate: 45deg; /* 휘어지면서 베어내는 느낌 */
}

/* 4. 고급 소환 마법진 (Concentric Rings) */
.spawn-glow {
    position: absolute;
    width: 11.111%;
    height: 10%;
    border-radius: 50%;
    border-width: 2px;
    border-color: rgba(100, 220, 255, 0.8);
    background-color: rgba(100, 220, 255, 0.1);
    scale: 0.1;
    opacity: 1;
    align-items: center;
    justify-content: center;
    picking-mode: ignore;
    transition-property: scale, opacity;
    transition-duration: 0.6s, 0.6s;
    transition-timing-function: ease-out, ease-out;
}
.spawn-glow--play {
    scale: 2.2;
    opacity: 0;
}

/* 마법진 내부 코어 */
.spawn-glow-inner {
    width: 60%;
    height: 60%;
    border-radius: 50%;
    background-color: rgba(200, 240, 255, 0.5);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.9);
    transition-property: scale, rotate;
    transition-duration: 0.6s, 0.6s;
    transition-timing-function: ease-out, linear;
}
.spawn-glow--play .spawn-glow-inner {
    scale: 0.3;
    rotate: 180deg;
}

/* ══════════════════════════════════════════ */
/* 다이내믹 이펙트 컬러 (Side & Difficulty)   */
/* ══════════════════════════════════════════ */

/* 적군 (Han) - 고급스러운 매트 루비 버건디 */
.effect-side-han.capture-slash {
    border-top-color: var(--theme-han-light);
    border-bottom-color: var(--theme-han-border);
}
.effect-side-han.spawn-glow {
    border-color: rgba(186, 52, 52, 0.9);
    background-color: rgba(186, 52, 52, 0.15);
}
.effect-side-han .spawn-glow-inner {
    border-color: rgba(245, 215, 215, 0.9);
    background-color: rgba(186, 52, 52, 0.5);
}
.effect-side-han.move-departure-ring {
    border-color: rgba(186, 52, 52, 0.8);
    background-color: rgba(186, 52, 52, 0.12);
}
.effect-side-han.move-landing-shockwave {
    border-color: rgba(186, 52, 52, 0.95);
    background-color: rgba(186, 52, 52, 0.25);
}
.effect-side-han .move-landing-core {
    background-color: rgba(245, 205, 205, 0.95);
}

/* 아군 (Cho) - 난이도별 색상 변화 */

/* 1. 하 (Easy) - 초록색 (Green) */
.effect-side-cho.effect-diff-easy.capture-slash {
    border-top-color: rgba(40, 255, 80, 1);
    border-bottom-color: rgba(150, 255, 150, 0.8);
}
.effect-side-cho.effect-diff-easy.spawn-glow {
    border-color: rgba(80, 255, 80, 0.9);
    background-color: rgba(80, 255, 80, 0.15);
}
.effect-side-cho.effect-diff-easy .spawn-glow-inner {
    border-color: rgba(200, 255, 200, 0.9);
    background-color: rgba(100, 255, 100, 0.5);
}
.effect-side-cho.effect-diff-easy.move-departure-ring {
    border-color: rgba(21, 115, 85, 0.8);
    background-color: rgba(21, 115, 85, 0.12);
}
.effect-side-cho.effect-diff-easy.move-landing-shockwave {
    border-color: rgba(34, 197, 94, 0.95);
    background-color: rgba(34, 197, 94, 0.25);
}
.effect-side-cho.effect-diff-easy .move-landing-core {
    background-color: rgba(187, 247, 208, 0.95);
}

/* 2. 중 (Normal) - 푸른색 (Blue, 기본 초나라 색상) */
.effect-side-cho.effect-diff-normal.capture-slash {
    border-top-color: rgba(40, 150, 255, 1);
    border-bottom-color: rgba(150, 200, 255, 0.8);
}
.effect-side-cho.effect-diff-normal.spawn-glow {
    border-color: rgba(100, 220, 255, 0.9);
    background-color: rgba(100, 220, 255, 0.15);
}
.effect-side-cho.effect-diff-normal .spawn-glow-inner {
    border-color: rgba(255, 255, 255, 0.9);
    background-color: rgba(150, 230, 255, 0.5);
}
.effect-side-cho.effect-diff-normal.move-departure-ring {
    border-color: rgba(29, 116, 178, 0.8);
    background-color: rgba(29, 116, 178, 0.12);
}
.effect-side-cho.effect-diff-normal.move-landing-shockwave {
    border-color: rgba(56, 189, 248, 0.95);
    background-color: rgba(56, 189, 248, 0.25);
}
.effect-side-cho.effect-diff-normal .move-landing-core {
    background-color: rgba(224, 242, 254, 0.95);
}

/* 3. 상 (Hard) - 보라색 (Purple) */
.effect-side-cho.effect-diff-hard.capture-slash {
    border-top-color: rgba(200, 40, 255, 1);
    border-bottom-color: rgba(220, 150, 255, 0.8);
}
.effect-side-cho.effect-diff-hard.spawn-glow {
    border-color: rgba(200, 100, 255, 0.9);
    background-color: rgba(200, 100, 255, 0.15);
}
.effect-side-cho.effect-diff-hard .spawn-glow-inner {
    border-color: rgba(240, 200, 255, 0.9);
    background-color: rgba(220, 150, 255, 0.5);
}
.effect-side-cho.effect-diff-hard.move-departure-ring {
    border-color: rgba(112, 44, 168, 0.8);
    background-color: rgba(112, 44, 168, 0.12);
}
.effect-side-cho.effect-diff-hard.move-landing-shockwave {
    border-color: rgba(192, 132, 252, 0.95);
    background-color: rgba(192, 132, 252, 0.25);
}
.effect-side-cho.effect-diff-hard .move-landing-core {
    background-color: rgba(243, 232, 255, 0.95);
}

/* 4. 극악 (Hell) - 미드나잇 건메탈 & 다크 티타늄 (Dark Gunmetal) */
.effect-side-cho.effect-diff-hell.capture-slash {
    border-top-color: rgba(39, 45, 60, 1);
    border-bottom-color: rgba(148, 163, 184, 0.85);
}
.effect-side-cho.effect-diff-hell.spawn-glow {
    border-color: rgba(79, 88, 110, 0.95);
    background-color: rgba(39, 45, 60, 0.35);
}
.effect-side-cho.effect-diff-hell .spawn-glow-inner {
    border-color: rgba(226, 232, 240, 0.95);
    background-color: rgba(79, 88, 110, 0.6);
}
.effect-side-cho.effect-diff-hell.move-departure-ring {
    border-color: rgba(39, 45, 60, 0.85);
    background-color: rgba(39, 45, 60, 0.18);
}
.effect-side-cho.effect-diff-hell.move-landing-shockwave {
    border-color: rgba(79, 88, 110, 0.95);
    background-color: rgba(39, 45, 60, 0.35);
}
.effect-side-cho.effect-diff-hell .move-landing-core {
    background-color: rgba(226, 232, 240, 0.95);
}

.callout-banner--visible {
    opacity: 1;
    display: flex;
}

.callout-banner--visible .callout-card-frame {
    scale: 1 1;
    opacity: 1;
}

.callout-card-frame {
    min-width: 290px;
    width: fit-content;
    padding: 24px 44px 22px 44px;
    border-radius: 24px;
    border-width: 4px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: rgb(255, 255, 255);
    transition-property: scale, opacity;
    transition-duration: 0.25s, 0.2s;
    transition-timing-function: ease-out-back, linear;
}

/* ── 1. 아군 플레이어 (楚 / Cho) 행마 시: 난이도 Primary 테마 ── */
.callout-banner--side-cho .callout-card-frame {
    border-color: var(--theme-primary);
    background-color: rgb(255, 255, 255);
}

.callout-banner--side-cho .callout-hanja {
    color: var(--theme-primary);
}

.callout-banner--side-cho .callout-divider-line {
    background-color: var(--theme-primary);
}

.callout-banner--side-cho .callout-subtitle {
    color: var(--theme-primary-dark);
    background-color: var(--theme-primary-tint);
    border-color: var(--theme-primary-border);
}

/* ── 2. 적군 AI (漢 / Han) 행마 시: 매트 루비 버건디 테마 ── */
.callout-banner--side-han .callout-card-frame {
    border-color: var(--theme-han-primary);
    background-color: rgb(255, 255, 255);
}

.callout-banner--side-han .callout-hanja {
    color: var(--theme-han-primary);
}

.callout-banner--side-han .callout-divider-line {
    background-color: var(--theme-han-primary);
}

.callout-banner--side-han .callout-subtitle {
    color: var(--theme-han-dark);
    background-color: var(--theme-han-tint);
    border-color: var(--theme-han-border);
}

/* ── 공통 타이포그래피 & 데코 ── */
.callout-hanja {
    font-size: 72px;
    -unity-font-style: bold;
    letter-spacing: 16px;
    -unity-text-align: middle-center;
    margin-right: -16px;
    margin-bottom: 4px;
    white-space: nowrap;
}

.callout-divider-line {
    width: 80%;
    min-width: 140px;
    height: 3px;
    margin: 8px 0 12px 0;
    border-radius: 2px;
}

.callout-subtitle {
    font-size: 24px;
    width: 100%;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    padding: 6px 22px 5px 22px;
    border-radius: 14px;
    border-width: 1.5px;
}

/* ── 왕(王) 기물 경고 펄스 & 비콘 ── */
.piece-container--danger {
    scale: 1.18;
}

.king-danger-beacon {
    position: absolute;
    width: 11.111%;
    height: 10%;
    border-radius: 50%;
    border-width: 4px;
    border-color: var(--theme-primary);
    background-color: var(--theme-primary-hover);
    scale: 0.7;
    opacity: 1;
    picking-mode: ignore;
    transition-property: scale, opacity, border-color;
    transition-duration: 0.55s, 0.55s, 0.55s;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.king-danger-beacon--play {
    scale: 2.3;
    opacity: 0;
    border-color: rgba(255, 255, 255, 0);
}

.king-danger-beacon.king-beacon--enemy {
    border-color: rgba(186, 52, 52, 0.95);
    background-color: rgba(186, 52, 52, 0.25);
}

.king-escape-beacon {
    position: absolute;
    width: 11.111%;
    height: 10%;
    border-radius: 50%;
    border-width: 3.5px;
    border-color: var(--theme-primary-light);
    background-color: var(--theme-primary-tint);
    scale: 0.7;
    opacity: 1;
    picking-mode: ignore;
    transition-property: scale, opacity, border-color;
    transition-duration: 0.45s, 0.45s, 0.45s;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.king-escape-beacon--play {
    scale: 2.0;
    opacity: 0;
    border-color: rgba(255, 255, 255, 0);
}

.king-escape-beacon.king-beacon--enemy {
    border-color: rgba(186, 52, 52, 0.85);
    background-color: rgba(186, 52, 52, 0.15);
}
