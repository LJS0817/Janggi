      m_Items: []
  - m_Id: 493320396812
    m_Localized: Game Rules Guide
    m_Metadata:
      m_Items: []
  - m_Id: 493320396813
    m_Localized: 1. Turn Sequence & Cost
    m_Metadata:
      m_Items: []
  - m_Id: 493320396814
    m_Localized: "\u2022 Gain +2 Cost at start of turn (Max 10 Cost)\r\n\u2022 Gain
      +1 Cost when capturing an enemy piece\r\n\u2022 [Optional] Spend cost to summon
      1 piece from hand\r\n\u2022 [Mandatory] Move 1 allied piece on board (Ends
      turn)"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396815
    m_Localized: 2. Spawn Zones
    m_Metadata:
      m_Items: []
  - m_Id: 493324591104
    m_Localized: "\u2022 Pawn/Soldier: Empty cell on 4th front rank\r\n\u2022 Cannon:
      Empty cell on 2 cannon starting positions\r\n\u2022 Chariot/Horse/Elephant:
      Empty cell on 1st back rank\r\n\u2022 Cannot summon to cells that cause direct
      check"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591105
    m_Localized: 3. Field Power Limit (20 Cost)
    m_Metadata:
      m_Items: []
  - m_Id: 493324591106
    m_Localized: "\u2022 Total cost of allied pieces on board is capped at 20\r\n\u2022
      Chariot(6), Cannon(4), Horse(2), Elephant(2), Pawn(1)\r\n\u2022 Pieces must
      be lost before summoning more"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591107
    m_Localized: 4. Discard Card (-1 Cost)
    m_Metadata:
      m_Items: []
  - m_Id: 493324591108
    m_Localized: "\u2022 Spend 1 Cost to discard an unwanted card and redraw immediately"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591109
    m_Localized: 5. Pass Turn
    m_Metadata:
      m_Items: []
  - m_Id: 493324591110
    m_Localized: "\u2022 Pass your turn without moving by clicking [Pass Turn].\r\n\u2022
      You cannot pass while in Check."
    m_Metadata:
      m_Items: []
