  - m_Id: 493324591187
    m_Localized: "\uC678\uD1B5\uC218 \uC81C\uC555"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591188
    m_Localized: "\uC678\uD1B5\uC218 \uD328\uBC30"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591189
    m_Localized: "\uBB34\uC2B9\uBD80 \uD310\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591190
    m_Localized: "\uAC8C\uC784 \uC885\uB8CC (\uBB34\uC2B9\uBD80)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591191
    m_Localized: "\u2022 \uC591\uCE21 \uBAA8\uB450 \uACF5\uACA9 \uAE30\uBB3C\uC774
      \uC18C\uC9C4\uB418\uC5C8\uAC70\uB098 \uAD50\uCC29 \uC0C1\uD0DC\uAC00 \uBC1C\uC0DD\uD558\uC5EC
      \uBB34\uC2B9\uBD80\uB85C \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591192
    m_Localized: "\uC678\uD1B5\uC218 \uC2B9\uB9AC (\uC678\uD1B5\uC218 \uC81C\uC555)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591193
    m_Localized: "\uC678\uD1B5\uC218 \uD328\uBC30 (\uC678\uD1B5\uC218 \uB2F9\uD568)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591194
    m_Localized: "\u2022 \uC9C1\uC811 \uC7A5\uAD70: {0}\uC774(\uAC00) {1}\uC744(\uB97C)
      \uC9C1\uC811 \uC870\uC900 \uACF5\uACA9 \uC911\uC785\uB2C8\uB2E4.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591195
    m_Localized: "\u2022 \uD1F4\uB85C \uCC28\uB2E8: {0}\uC774(\uAC00) \uAD81\uC758
      \uD0C8\uCD9C\uB85C\uB97C \uD1B5\uC81C\uD558\uC5EC \uB3C4\uB9DD\uCE60 \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591196
    m_Localized: "\u2022 \uD1F4\uB85C \uCC28\uB2E8: \uAD81\uC131 \uB0B4 \uBAA8\uB4E0
      \uC778\uC811 \uCE78\uC774 \uC0C1\uB300 \uAE30\uBB3C\uC758 \uACF5\uACA9 \uBC94\uC704\uC5D0
      \uB9C9\uD600 \uC788\uC2B5\uB2C8\uB2E4.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591197
    m_Localized: "\u2022 \uC218\uBE44 \uBD88\uAC00: \uACF5\uACA9 \uAE30\uBB3C\uC744
      \uC7A1\uAC70\uB098 \uC0AC\uC774\uB97C \uAC00\uB85C\uB9C9\uC744 \uC218 \uC788\uB294
      \uD569\uBC95 \uC218\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
