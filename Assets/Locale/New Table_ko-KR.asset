  m_TableData:
  - m_Id: 493253287936
    m_Localized: "\uC7A5\uAE30 \uB371\uBE4C\uB529 \uB514\uD39C\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 493316202496
    m_Localized: "\uD63C\uC790\uD558\uB294 \uC7A5\uAE30 \uBBF8\uB2C8\uAC8C\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396800
    m_Localized: "AI \uB09C\uC774\uB3C4 \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396801
    m_Localized: "\uC785\uBB38"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396802
    m_Localized: "\uBB34\uC791\uC704 \uC18C\uD658\r\n\uCD08\uBCF4\uC790 \uCD94\uCC9C"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396803
    m_Localized: "\uBCF4\uD1B5"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396804
    m_Localized: "\uC790\uC6D0 \uBE44\uCD95\r\n\uD45C\uC900 \uBC38\uB7F0\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396805
    m_Localized: "\uC219\uB828"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396806
    m_Localized: "\uC5F0\uACC4\r\n\uC2A4\uD3F0 \uBE14\uB85C\uD0B9"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396807
    m_Localized: "\uADF9\uC545"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396808
    m_Localized: "\uC678\uD1B5\uC218 \uC62C\uC778\r\n\uC644\uBCBD\uD55C \uC218\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396809
    m_Localized: "\uAC8C\uC784 \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396810
    m_Localized: "\uAC8C\uC784 \uBC29\uBC95 / \uADDC\uCE59"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396811
    m_Localized: "\uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396812
    m_Localized: "\uAC8C\uC784 \uADDC\uCE59 \uC548\uB0B4"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396813
    m_Localized: "1. \uD134 \uC21C\uC11C \uBC0F \uC790\uC6D0 (Cost)"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396814
    m_Localized: "\u2022 \uB9E4 \uD134 \uC2DC\uC791 \uC2DC \uCF54\uC2A4\uD2B8 +2
      \uD68C\uBCF5 (\uCD5C\uB300 10 \uCF54\uC2A4\uD2B8)\r\n\u2022 \uC0C1\uB300 \uAE30\uBB3C
      \uCC98\uCE58 \uC2DC \uCF54\uC2A4\uD2B8 +1 \uD68D\uB4DD\r\n\u2022 [\uC120\uD0DD]
      \uC190\uD328\uC5D0\uC11C \uCF54\uC2A4\uD2B8\uB97C \uC9C0\uBD88\uD558\uC5EC
      \uAE30\uBB3C 1\uAC1C \uC18C\uD658\r\n\u2022 [\uD544\uC218] \uBCF4\uB4DC \uC704
      \uC544\uAD70 \uAE30\uBB3C 1\uAC1C \uC774\uB3D9 (\uC774\uB3D9 \uC644\uB8CC \uC2DC
      \uD134 \uC885\uB8CC)"
    m_Metadata:
      m_Items: []
  - m_Id: 493320396815
    m_Localized: "2. \uC18C\uD658 \uAD6C\uC5ED (Spawn Zones)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591104
    m_Localized: "\u2022 \uC878/\uBCD1: \uC544\uAD70 4\uC120 \uC804\uBC29 \uB77C\uC778
      \uBE48\uCE78\r\n\u2022 \uD3EC: \uC544\uAD70 2\uACF3\uC758 \uD3EC\uC9C4\uC9C0
      \uBE48\uCE78\r\n\u2022 \uCC28/\uB9C8/\uC0C1: \uC544\uAD70 1\uC120 \uCD5C\uD6C4\uBC29
      \uB77C\uC778 \uBE48\uCE78\r\n\u2022 \uC18C\uD658 \uC989\uC2DC \uC7A5\uAD70\uC774
      \uB418\uB294 \uCE78\uC5D0\uB294 \uC18C\uD658 \uBD88\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591105
    m_Localized: "3. \uD544\uB4DC \uC804\uB825 \uC0C1\uD55C (20 \uCF54\uC2A4\uD2B8)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591106
    m_Localized: "\u2022 \uD310 \uC704\uC5D0 \uC874\uC7AC\uD558\uB294 \uC544\uAD70
      \uAE30\uBB3C \uCD1D \uCF54\uC2A4\uD2B8\uB294 \uCD5C\uB300 20\uAE4C\uC9C0\uB9CC
      \uC720\uC9C0 \uAC00\uB2A5\r\n\u2022 \uCC28(6), \uD3EC(4), \uB9C8(2), \uC0C1(2),
      \uC878(1)\r\n\u2022 \uAE30\uBB3C\uC774 \uC804\uC0AC\uD574\uC57C \uC0C8 \uAE30\uBB3C\uC744
      \uCD94\uAC00 \uC18C\uD658 \uAC00\uB2A5"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591107
    m_Localized: "4. \uD328 \uBC84\uB9AC\uAE30 (-1 \uCF54\uC2A4\uD2B8)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591108
    m_Localized: "\u2022 1 \uCF54\uC2A4\uD2B8\uB97C \uC18C\uBAA8\uD558\uC5EC \uC6D0\uD558\uC9C0
      \uC54A\uB294 \uC190\uD328\uB97C \uBC84\uB9AC\uACE0 \uC989\uC2DC \uC0C8 \uCE74\uB4DC\uB85C
      \uB9AC\uD544 \uAC00\uB2A5"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591109
    m_Localized: "5. \uD55C \uC218 \uC27C (\uD55C \uD134 \uC26C\uAE30)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591110
    m_Localized: "\u2022 \uAE30\uBB3C\uC744 \uC774\uB3D9\uD558\uC9C0 \uC54A\uACE0
      [\uD55C \uC218 \uC27C] \uBC84\uD2BC\uC744 \uB20C\uB7EC \uD134\uC744 \uC0C1\uB300\uC5D0\uAC8C
      \uB118\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\u2022 \uB2E8, \uC7A5\uAD70(Check)
      \uC0C1\uD0DC\uC5D0\uC11C\uB294 \uC274 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591111
    m_Localized: "\uB09C\uC774\uB3C4: "
    m_Metadata:
      m_Items: []
  - m_Id: 493324591112
    m_Localized: "\uC7AC\uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591113
    m_Localized: "\uBA54\uB274"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591114
    m_Localized: "\u695A (\uD50C\uB808\uC774\uC5B4)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591115
    m_Localized: "\u6F22 (\uC801 AI)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591116
    m_Localized: "\uCF54\uC2A4\uD2B8: {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591117
    m_Localized: "\uC804\uB825: {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591118
    m_Localized: "\uD328 \uBC84\uB9AC\uAE30 (-1)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591119
    m_Localized: "\uBC84\uB9B4 \uCE74\uB4DC \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591120
    m_Localized: "\uD55C \uC218 \uC27C"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591121
    m_Localized: "\uCD08(\u695A)\uC758 \uCC28\uB840"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591122
    m_Localized: "\uD55C(\u6F22)\uC758 \uCC28\uB840"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591123
    m_Localized: "\uC878"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591124
    m_Localized: "\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591125
    m_Localized: "\uB9C8"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591126
    m_Localized: "\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591127
    m_Localized: "\uD3EC"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591128
    m_Localized: "\uCC28"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591129
    m_Localized: "\uAD81"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591130
    m_Localized: "\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591131
    m_Localized: "\uC2B9\uB9AC (\u52DD\u5229)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591132
    m_Localized: "\uC801\uC758 \uAD81\uC744 \uC678\uD1B5\uC218\uB85C \uBA4B\uC9C0\uAC8C
      \uC81C\uC555\uD588\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591133
    m_Localized: "\uD328\uBC30 (\u6557\u5317)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591134
    m_Localized: "\uC544\uAD70 \uAD81\uC774 \uC678\uD1B5\uC218\uB85C \uC81C\uC555\uB2F9\uD588\uC2B5\uB2C8\uB2E4..."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591135
    m_Localized: "\uBB34\uC2B9\uBD80 (\u5F15\u5206)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591136
    m_Localized: "\uC591\uCE21\uC758 \uACF5\uBC29 \uB05D\uC5D0 \uAD50\uCC29 \uC0C1\uD0DC\uAC00
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591137
    m_Localized: "\uB09C\uC774\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591138
    m_Localized: "\uC18C\uC694 \uD134\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591139
    m_Localized: "{0} \uD134"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591140
    m_Localized: "\uCC98\uCE58\uD55C \uC801 \uAE30\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591141
    m_Localized: "{0} \uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591142
    m_Localized: "\uC18C\uD658\uD55C \uC544\uAD70 \uAE30\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591143
    m_Localized: "{0} \uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591146
    m_Localized: "\uC0C8 \uAC8C\uC784 \uC2DC\uC791\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591147
    m_Localized: "\uBA54\uC778 \uBA54\uB274\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591144
    m_Localized: "\uAD11\uACE0 \uCC2C\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591145
    m_Localized: "\uCC2C\uC2A4 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591148
    m_Localized: "\uAC8C\uC784 \uC2DC\uC791! \uCD08(\u695A)\uC758 \uCC28\uB840\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591149
    m_Localized: "\uD574\uB2F9 \uC704\uCE58\uC5D0\uB294 \uC18C\uD658\uD560 \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591150
    m_Localized: "\uD544\uB4DC \uC804\uB825 \uD55C\uB3C4({0})\uB97C \uCD08\uACFC\uD558\uC5EC
      \uC18C\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591151
    m_Localized: "\uCF54\uC2A4\uD2B8\uAC00 \uBD80\uC871\uD558\uAC70\uB098 \uC774\uBBF8
      \uC18C\uD658\uC744 \uC644\uB8CC\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591152
    m_Localized: "[{0}] \uC18C\uD658 \uC644\uB8CC! \uC774\uB3D9\uD560 \uAE30\uBB3C\uC744
      \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591153
    m_Localized: "\uD328\uB97C \uBC84\uB9B4 \uCF54\uC2A4\uD2B8(1)\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591154
    m_Localized: "[{0}] \uCE74\uB4DC\uB97C \uBC84\uB9AC\uACE0 \uC0C8 \uCE74\uB4DC\uB97C
      \uBF51\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591155
    m_Localized: "\uC7A5\uAD70(Check) \uC0C1\uD0DC\uC5D0\uC11C\uB294 \uD55C \uC218
      \uC274 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4! \uC655\uC744 \uC9C0\uD0A4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591156
    m_Localized: "\uCD08(\u695A) \uD50C\uB808\uC774\uC5B4\uAC00 \uD55C \uC218 \uC26C\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591157
    m_Localized: "\uC678\uD1B5\uC218! {0} \uC2B9\uB9AC!"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591158
    m_Localized: "\uAD50\uCC29 \uC0C1\uD0DC! \uBB34\uC2B9\uBD80!"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591159
    m_Localized: "\uC7A5\uAD70! {0}\uC774(\uAC00) \uC704\uD5D8\uD569\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591160
    m_Localized: "\uC801 AI(\u6F22)\uAC00 \uC218\uB97C \uACE0\uBBFC \uC911\uC785\uB2C8\uB2E4..."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591161
    m_Localized: "\uC801 AI(\u6F22)\uAC00 [{0}] \uC18C\uD658! (AI \uB0A8\uC740 \uCF54\uC2A4\uD2B8:
      {1})"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591162
    m_Localized: "\uC801 AI(\u6F22)\uAC00 [{0}]\uC744(\uB97C) \uC774\uB3D9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591163
    m_Localized: "\uB09C\uC774\uB3C4\uAC00 [{0}]\uB85C \uBCC0\uACBD\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591201
    m_Localized: "\uAD11\uACE0\r\n\uB85C\uB529 \uC911..."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591166
    m_Localized: "\uAD11\uACE0 \uC2DC\uCCAD \uC644\uB8CC!"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591167
    m_Localized: "\uAD11\uACE0 \uC2DC\uCCAD\uC774 \uCDE8\uC18C\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591168
    m_Localized: "\uC774\uBC88 \uD134 \uC18C\uD658\uC744 \uC774\uBBF8 \uC644\uB8CC\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591169
    m_Localized: "\uCF54\uC2A4\uD2B8\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591170
    m_Localized: "[{0}] \uC18C\uD658\uD560 \uBE48 \uCE78\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591171
    m_Localized: "\uCD08(\u695A) \uD50C\uB808\uC774\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591172
    m_Localized: "\uD55C(\u6F22) \uC801 AI"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591173
    m_Localized: "\uCD08(\u695A)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591174
    m_Localized: "\uD55C(\u6F22)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591175
    m_Localized: "\uC9C0\uC6D0 \uC694\uCCAD \uC131\uACF5! \uC81C\uAC70\uD560 \uC801
      \uAE30\uBB3C\uC744 \uC120\uD0DD\uD558\uC138\uC694. (\uC655/\uC0AC \uC81C\uC678)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591176
    m_Localized: "\uC9C0\uC6D0 \uD3ED\uACA9! \uC801\uC758 [{0}]\uC744(\uB97C) \uD30C\uAD34\uD588\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591177
    m_Localized: "\uC81C\uAC70\uD560 \uC218 \uC788\uB294 \uC801 \uAE30\uBB3C\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4. (\uC655/\uC0AC \uC81C\uC678)"
    m_Metadata:
      m_Items: []
  - m_Id: 493324591178
    m_Localized: "\uAD11\uACE0 \uCC2C\uC2A4\uB294 \uAC8C\uC784\uB2F9 1\uD68C\uB9CC
      \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 493324591179
    m_Localized: "\uD50C\uB808\uC774\uC5B4 \uD134\uC5D0\uB9CC \uAD11\uACE0 \uCC2C\uC2A4\uB97C
